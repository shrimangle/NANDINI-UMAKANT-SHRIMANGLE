# ---- Copy this file to .env.local and fill in the values ----

# ADMIN LOGIN (no database needed for login - it is checked against these two values)
ADMIN_EMAIL=Shrimangalenandini28@gmail.com
ADMIN_PASSWORD=choose-a-strong-password

# Long random text used to sign the login cookie (min 32 characters).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-text-at-least-32-characters

# MongoDB Atlas connection string (stores contact messages + projects). Optional but recommended.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# Email notification when someone sends a message (Gmail App Password, NOT your normal password)
EMAIL_USER=Shrimangalenandini28@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_TO=Shrimangalenandini28@gmail.com

# Your live website URL (used for sitemap + SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
